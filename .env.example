# Copy to .env and fill in from Firebase console > Project settings > Your apps (Web).
# These are public client identifiers, not secrets, but keep them out of source control
# so each environment (dev/staging/prod) can use its own project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in: the OAuth "Web client" ID (Firebase console > Authentication > Sign-in method >
# Google > Web SDK configuration, or the client with "client_type": 3 in google-services.json).
# Leave blank to turn the button off.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional. Defaults to asia-southeast1, where the Cloud Functions deploy (see functions/src/index.ts).
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=
